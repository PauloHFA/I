{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "baseUrl": ".",
    "paths": {
      "@domain/*": ["after/src/domain/*"],
      "@application/*": ["after/src/application/*"],
      "@infra/*": ["after/src/infra/*"]
    }
  },
  "include": [
    "before/**/*",
    "after/**/*"
  ],
  "exclude": ["node_modules", "dist"]
}